#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_dir=$(CDPATH= cd -- "$script_dir/.." && pwd)
case_root=${1:-"$repo_dir/tests/corpus"}
out_dir=${2:-}

[ -n "$out_dir" ] || {
    printf 'usage: %s [CASE_DIR] OUTPUT_DIR\n' "$0" >&2
    exit 64
}

command -v jq >/dev/null 2>&1 || {
    printf 'cockswain: jq is required\n' >&2
    exit 69
}

[ -d "$case_root" ] || {
    printf 'cockswain: corpus case directory not found: %s\n' "$case_root" >&2
    exit 66
}

mkdir -p "$out_dir"
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT HUP INT TERM

found=0
for case_path in "$case_root"/*.case; do
    [ -f "$case_path" ] || continue
    found=1
    case_id=$(basename "$case_path" .case)

    expected_with=$(awk -F '\t' '$1 == "expected_with_history" {print $2; exit}' "$case_path")
    expected_without=$(awk -F '\t' '$1 == "expected_without_history" {print $2; exit}' "$case_path")
    [ -n "$expected_without" ] || expected_without=$expected_with

    for expected in "$expected_with" "$expected_without"; do
        case "$expected" in
            CONTINUE|WAIT|HUMAN|DONE) ;;
            *)
                printf 'cockswain: %s has invalid expected action\n' "$case_id" >&2
                exit 65
                ;;
        esac
    done

    goal=$(awk -F '\t' '$1 == "goal" {sub(/^[^\t]*\t/, ""); print; exit}' "$case_path")
    state=$(awk -F '\t' '$1 == "state" {sub(/^[^\t]*\t/, ""); print; exit}' "$case_path")
    [ -n "$goal" ] && [ -n "$state" ] || {
        printf 'cockswain: %s is missing goal or state\n' "$case_id" >&2
        exit 65
    }

    jq -Rn '[inputs | select(startswith("unresolved\t")) | sub("^unresolved\t"; "")]' \
        "$case_path" > "$work/unresolved.json"
    jq -Rn '[inputs | select(startswith("done_when\t")) | sub("^done_when\t"; "")]' \
        "$case_path" > "$work/done_when.json"
    jq -e 'length > 0' "$work/done_when.json" >/dev/null || {
        printf 'cockswain: %s has no done_when condition\n' "$case_id" >&2
        exit 65
    }

    : > "$work/history.ndjson"
    : > "$work/records.ndjson"
    history_count=0

    while IFS="$(printf '\t')" read -r key rel record extra; do
        [ "$key" = history_record ] || continue
        [ -z "${extra:-}" ] || {
            printf 'cockswain: %s has malformed history_record\n' "$case_id" >&2
            exit 65
        }
        case "/$rel/" in
            */../*)
                printf 'cockswain: %s history path escapes corpus: %s\n' "$case_id" "$rel" >&2
                exit 65
                ;;
        esac
        case "$rel" in
            corpus/chat-history/*.txt) ;;
            *)
                printf 'cockswain: %s history must reference corpus/chat-history/*.txt: %s\n' "$case_id" "$rel" >&2
                exit 65
                ;;
        esac
        case "$record" in
            ''|*[!0-9]*)
                printf 'cockswain: %s has invalid record id: %s\n' "$case_id" "$record" >&2
                exit 65
                ;;
        esac

        source_file="$repo_dir/$rel"
        [ -f "$source_file" ] || {
            printf 'cockswain: %s history source not found: %s\n' "$case_id" "$rel" >&2
            exit 66
        }

        body="$work/body"
        role_file="$work/role"
        : > "$body"
        : > "$role_file"

        if ! awk -v target="$record" -v role_out="$role_file" '
          /^record: / {
            if (capture && in_body) exit
            capture = ($2 == target)
            in_body = 0
            next
          }
          capture && !in_body && /^role: / {
            role = substr($0, 7)
            next
          }
          capture && $0 == "---" {
            in_body = 1
            next
          }
          capture && in_body && $0 == "===" {
            found = 1
            exit
          }
          capture && in_body {
            print
          }
          END {
            if (!found || role == "") exit 42
            print role > role_out
          }
        ' "$source_file" > "$body"; then
            printf 'cockswain: %s could not extract %s record %s\n' "$case_id" "$rel" "$record" >&2
            exit 65
        fi

        role=$(cat "$role_file")
        jq -n --arg role "$role" --rawfile content "$body" \
            '{role: $role, content: ($content | rtrimstr("\n"))}' >> "$work/history.ndjson"
        jq -n --arg file "$rel" --arg record "$record" \
            '{file: $file, record: $record}' >> "$work/records.ndjson"
        history_count=$((history_count + 1))
    done < "$case_path"

    [ "$history_count" -gt 0 ] || {
        printf 'cockswain: %s has no history_record entries\n' "$case_id" >&2
        exit 65
    }

    jq -s '.' "$work/history.ndjson" > "$work/history.json"
    jq -s '.' "$work/records.ndjson" > "$work/records.json"

    jq -n \
        --arg case_id "$case_id" \
        --arg expected_with "$expected_with" \
        --arg expected_without "$expected_without" \
        --arg goal "$goal" \
        --arg state "$state" \
        --slurpfile unresolved "$work/unresolved.json" \
        --slurpfile done_when "$work/done_when.json" \
        --slurpfile history "$work/history.json" \
        --slurpfile records "$work/records.json" \
        '{
          case_id: $case_id,
          expected_action: $expected_with,
          expected_action_with_history: $expected_with,
          expected_action_without_history: $expected_without,
          goal: $goal,
          state: {summary: $state},
          unresolved: $unresolved[0],
          done_when: $done_when[0],
          source: {
            history: {
              kind: "public_verbatim_corpus",
              records: $records[0]
            }
          },
          chat_history: $history[0]
        }' > "$out_dir/$case_id.json"
done

[ "$found" -eq 1 ] || {
    printf 'cockswain: no .case files found under %s\n' "$case_root" >&2
    exit 65
}
