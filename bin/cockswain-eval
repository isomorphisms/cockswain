#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_dir=$(CDPATH= cd -- "$script_dir/.." && pwd)
case_dir=${1:-"$repo_dir/tests/cases"}
history_mode=${COCKSWAIN_HISTORY_MODE:-with}
supervisor_cmd=${COCKSWAIN_SUPERVISOR_CMD:-"$script_dir/cockswain-supervise"}

case "$history_mode" in
    with|without) ;;
    *)
        printf 'cockswain: COCKSWAIN_HISTORY_MODE must be with or without\n' >&2
        exit 64
        ;;
esac

total=0
correct=0
false_done=0
false_human=0
invalid=0
semantic_failures=0
continue_expected=0
continue_returned=0
false_continue=0
false_stopping=0

printf 'case\texpected\tactual\tresult\n'

for case_file in "$case_dir"/*.json; do
    [ -e "$case_file" ] || continue

    total=$((total + 1))
    case_id=$(jq -r '.case_id // input_filename' "$case_file")
    expected=$(jq -er --arg mode "$history_mode" '
      if $mode == "with" then
        (.expected_action_with_history // .expected_action)
      else
        (.expected_action_without_history // .expected_action)
      end
    ' "$case_file")
    required_output=$(jq -r '.expected_required_output[]?' "$case_file")
    forbidden_output=$(jq -r '.expected_forbidden_output[]?' "$case_file")

    case "$expected" in
        CONTINUE|WAIT|HUMAN|DONE) ;;
        *)
            printf 'cockswain: %s has invalid expected action for history mode %s\n' "$case_id" "$history_mode" >&2
            exit 65
            ;;
    esac

    result_tmp=$(mktemp)
    case_tmp=$(mktemp)
    cleanup() {
        rm -f "$result_tmp" "$case_tmp"
    }
    trap cleanup EXIT HUP INT TERM

    jq --arg mode "$history_mode" '
      (if $mode == "without" then
         .chat_history = [] | del(.source.history)
       else
         .
       end)
      | del(
          .expected_action,
          .expected_action_with_history,
          .expected_action_without_history,
          .expected_required_output,
          .expected_forbidden_output
        )
    ' "$case_file" > "$case_tmp"

    if "$supervisor_cmd" "$case_tmp" >"$result_tmp" && jq -e -s '
        length == 1 and (.[0] |
          type == "object" and
          (keys | sort) == (["action", "rationale", "next_prompt", "human_question", "evidence_gaps"] | sort) and
          (.action == "CONTINUE" or .action == "WAIT" or .action == "HUMAN" or .action == "DONE") and
          (.rationale | type == "string" and test("\\S")) and
          (.evidence_gaps | type == "array" and all(.[]; type == "string")) and
          (if .action == "CONTINUE" then
             (.next_prompt | type == "string" and test("\\S")) and .human_question == null
           elif .action == "HUMAN" then
             .next_prompt == null and (.human_question | type == "string" and test("\\S"))
           else .next_prompt == null and .human_question == null end)
        )
      ' "$result_tmp" >/dev/null 2>&1; then
        actual=$(jq -r '.action' "$result_tmp")
    else
        actual=INVALID
    fi

    semantic_ok=1
    if [ "$actual" != INVALID ]; then
        rendered=$(jq -r '[.rationale, .next_prompt, .human_question, (.evidence_gaps[]?)] | map(select(. != null)) | join("\n")' "$result_tmp")
        old_ifs=$IFS
        IFS='
'
        for term in $required_output; do
            [ -n "$term" ] || continue
            printf '%s\n' "$rendered" | grep -Fi -- "$term" >/dev/null || semantic_ok=0
        done
        for term in $forbidden_output; do
            [ -n "$term" ] || continue
            if printf '%s\n' "$rendered" | grep -Fi -- "$term" >/dev/null; then
                semantic_ok=0
            fi
        done
        IFS=$old_ifs
    fi

    result=FAIL
    if [ "$actual" = "$expected" ] && [ "$semantic_ok" -eq 1 ]; then
        correct=$((correct + 1))
        result=PASS
    elif [ "$semantic_ok" -eq 0 ]; then
        semantic_failures=$((semantic_failures + 1))
    fi

    if [ "$actual" = DONE ] && [ "$expected" != DONE ]; then
        false_done=$((false_done + 1))
    fi
    if [ "$actual" = HUMAN ] && [ "$expected" != HUMAN ]; then
        false_human=$((false_human + 1))
    fi
    if [ "$actual" = INVALID ]; then
        invalid=$((invalid + 1))
    fi
    if [ "$expected" = CONTINUE ]; then
        continue_expected=$((continue_expected + 1))
        if [ "$result" != PASS ]; then
            false_stopping=$((false_stopping + 1))
        fi
    fi
    if [ "$actual" = CONTINUE ]; then
        continue_returned=$((continue_returned + 1))
        if [ "$expected" != CONTINUE ] || [ "$semantic_ok" -eq 0 ]; then
            false_continue=$((false_continue + 1))
        fi
    fi

    printf '%s\t%s\t%s\t%s\n' "$case_id" "$expected" "$actual" "$result"
    cleanup
    trap - EXIT HUP INT TERM
done

printf '\n'
printf 'history_mode\t%s\n' "$history_mode"
printf 'total\t%d\n' "$total"
printf 'correct\t%d\n' "$correct"
printf 'false_done\t%d\n' "$false_done"
printf 'false_human\t%d\n' "$false_human"
printf 'invalid_output\t%d\n' "$invalid"
printf 'semantic_contract_failures\t%d\n' "$semantic_failures"
printf 'expected_continue_total\t%d\n' "$continue_expected"
printf 'returned_continue_total\t%d\n' "$continue_returned"
printf 'false_continue\t%d\n' "$false_continue"
printf 'false_stopping\t%d\n' "$false_stopping"

[ "$total" -gt 0 ] &&
[ "$correct" -eq "$total" ] &&
[ "$false_done" -eq 0 ] &&
[ "$false_human" -eq 0 ] &&
[ "$invalid" -eq 0 ] &&
[ "$semantic_failures" -eq 0 ]
