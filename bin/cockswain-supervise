#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_dir=$(CDPATH= cd -- "$script_dir/.." && pwd)

if [ "$#" -ne 1 ]; then
    printf 'usage: %s WORK_ITEM.json\n' "$0" >&2
    exit 64
fi

case_file=$1
model=${COCKSWAIN_MODEL:?set COCKSWAIN_MODEL}
base_url=${COCKSWAIN_BASE_URL:-http://127.0.0.1:8000/v1}
send_reasoning=${COCKSWAIN_SEND_REASONING_EFFORT:-0}

command -v jq >/dev/null 2>&1 || {
    printf 'cockswain: jq is required\n' >&2
    exit 69
}
command -v curl >/dev/null 2>&1 || {
    printf 'cockswain: curl is required\n' >&2
    exit 69
}

system_prompt=$(cat "$repo_dir/prompts/supervisor.md")
work_item=$(jq -c '
  del(
    .case_id,
    .expected_action,
    .expected_action_with_history,
    .expected_action_without_history,
    .expected_required_output,
    .expected_forbidden_output
  )
' "$case_file")

payload=$(jq -n \
    --arg model "$model" \
    --arg system "$system_prompt" \
    --arg item "$work_item" \
    '{
      model: $model,
      temperature: 0,
      messages: [
        {role: "system", content: $system},
        {role: "user", content: ("Evaluate this work state:\n" + $item)}
      ]
    }')

if [ "$send_reasoning" = 1 ]; then
    payload=$(printf '%s\n' "$payload" | jq '. + {reasoning_effort: "high"}')
fi

raw=$(curl -fsS \
    -H 'Content-Type: application/json' \
    --data "$payload" \
    "$base_url/chat/completions")

content=$(printf '%s\n' "$raw" | jq -er '.choices[0].message.content')

if ! printf '%s\n' "$content" | jq -e '
    (type == "object") and
    (.action == "CONTINUE" or .action == "WAIT" or .action == "HUMAN" or .action == "DONE") and
    (.rationale | type == "string") and
    ((.next_prompt | type) == "string" or .next_prompt == null) and
    ((.human_question | type) == "string" or .human_question == null) and
    (.evidence_gaps | type == "array") and
    (if .action == "CONTINUE" then (.next_prompt | type == "string") and (.human_question == null) else true end) and
    (if .action == "HUMAN" then (.human_question | type == "string") else true end)
' >/dev/null 2>&1; then
    printf 'cockswain: model returned output outside the supervisor contract\n%s\n' "$content" >&2
    exit 65
fi

printf '%s\n' "$content" | jq -c '{
    action,
    rationale,
    next_prompt,
    human_question,
    evidence_gaps
}'
