{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/isomorphisms/cockswain/schemas/work-item.schema.json",
  "title": "Cockswain work item",
  "type": "object",
  "required": ["goal", "state", "done_when", "chat_history"],
  "properties": {
    "case_id": {"type": "string"},
    "expected_action": {"enum": ["CONTINUE", "WAIT", "HUMAN", "DONE"]},
    "expected_action_with_history": {"enum": ["CONTINUE", "WAIT", "HUMAN", "DONE"]},
    "expected_action_without_history": {"enum": ["CONTINUE", "WAIT", "HUMAN", "DONE"]},
    "goal": {"type": "string", "minLength": 1},
    "source": {"type": "object"},
    "state": {"type": "object"},
    "unresolved": {
      "type": "array",
      "items": {"type": "string"}
    },
    "done_when": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "chat_history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": {"type": "string"},
          "content": {"type": "string"},
          "time": {"type": ["number", "null"]},
          "node_id": {"type": ["string", "null"]},
          "parent_id": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
